# Local stack (docker compose in this folder). Copy to .env and fill in. Never commit .env: all repos are public.
# Only what is required. Every other variable (models, limits, cities, tuning, flags) has a default in
# prompt-battle-api/src/main/resources/application.yml (docs/SPEC.md §11.1): don't add it unless you change it,
# and never leave a value empty (an empty number crashes the API).
# Production uses the same variables in Railway (docs/DEPLOYMENT.md), kept in the git-ignored secrets/railway.env.

# fake = offline, no keys needed. Empty (SPRING_PROFILES_ACTIVE=) = real providers below (spends credits).
SPRING_PROFILES_ACTIVE=fake

# One per city, 24+ characters, different from production (openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-32)
ADMIN_TOKEN_MDE=change-me-to-a-random-string-of-24-plus-chars
ADMIN_TOKEN_BOG=change-me-to-another-random-string-of-24-plus-chars

# Real providers only (ignored by the fake profile). Images on BFL only (docs/DECISIONS.md D-027).
IMAGE_PROVIDER_CHAIN=bfl
IMAGE_LOAD_SPLIT=bfl
BFL_API_KEY=your-bfl-key
GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
