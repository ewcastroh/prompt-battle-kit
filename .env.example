# Copy to .env and fill in. Never commit .env: all repos are public.
# Used by docker compose (parent folder) and mirrors the API variables in docs/SPEC.md §11.1.

# App
PUBLIC_UI_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
CITIES=mde:Medellín,bog:Bogotá
ADMIN_TOKEN_MDE=change-me-to-a-random-string-of-24-plus-chars
ADMIN_TOKEN_BOG=change-me-to-another-random-string-of-24-plus-chars
DATA_DIR=/data

# Spring profile: "fake" runs fully offline with no keys. Empty = real providers.
SPRING_PROFILES_ACTIVE=fake

# Image generation (failover order)
# Only fal.ai and BFL are built (docs/DECISIONS.md D-011, D-012)
IMAGE_PROVIDER_CHAIN=fal,bfl
IMAGE_LOAD_SPLIT=fal,bfl
FAL_KEY=
FAL_MODEL=fal-ai/flux-2/klein/9b
# = the limit shown in the fal.ai concurrency dashboard (US$10 of credit -> 10)
FAL_MAX_CONCURRENCY=10
BFL_API_KEY=
BFL_MODEL=flux-2-klein-9b
BFL_MAX_CONCURRENCY=24

# Embeddings (failover order)
# Gemini free tier (D-013): dashboard limits are 100 RPM / 30K TPM / 1K RPD
GEMINI_API_KEY=
EMBEDDING_PROVIDER_CHAIN=gemini,cohere
EMBEDDING_MODE=entries
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_RPM=90
GEMINI_EMBEDDING_TPM=27000
GEMINI_EMBEDDING_RPD=1000
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v4.0

# Commentary
ANTHROPIC_API_KEY=
COMMENTARY_MODEL=claude-sonnet-5-5

# Tuning
IMAGE_TIMEOUT_SECONDS=45
ATTEMPTS_PER_ROUND=3
ROUND_GRACE_SECONDS=20
CALIBRATION_ANCHORS=6
MINI_PODIUM_ENABLED=true

# Feature flags (decide after the dry run)
PROMPT_TRANSLATE_TO_EN=false
PROMPT_LLM_MODERATION=false
