{
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx ng *)",
      "Bash(scripts/loadtest.sh *)",
      "Bash(docker build *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(git push --force *)"
    ]
  }
}
